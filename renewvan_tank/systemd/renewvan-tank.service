[Unit]
Description=renewvan-tank MQTT driver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/renewvan-tank
ExecStart=/opt/renewvan-tank/.venv/bin/python -m renewvan_tank.main --config /opt/renewvan-tank/config.ini
Restart=on-failure
RestartSec=5
User=renewvan

[Install]
WantedBy=multi-user.target
